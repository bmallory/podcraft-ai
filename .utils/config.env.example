# ==============================================================================
# EXEMPLE DE CONFIGURATION - DUPLIQUEZ CE FICHIER VERS config.env
# ==============================================================================
PROJECT_PREFIX="thematic-podcast"
AWS_REGION="eu-west-1"
AWS_ACCOUNT_ID=""

# S3 & IAM
S3_BUCKET_NAME="thematic-podcast-audio-storage-eu-west-1"
IAM_ROLE_NAME="${PROJECT_PREFIX}-lambda-execution-role"
SFN_ROLE_NAME="${PROJECT_PREFIX}-stepfunctions-role"

# Thème du Podcast
PODCAST_TITLE="Tech & IA Horizon"
PODCAST_HOST="Alex, votre guide tech"
PODCAST_THEME="L'Intelligence Artificielle, la robotique, les innovations technologiques et le futur du numérique"
PODCAST_DURATION="8 à 12 minutes"
PODCAST_LANGUAGE="FRANÇAIS"

# Clés API & Modèles IA
GEMINI_API_KEY=""
GEMINI_SCRIPT_MODEL="gemini-3.7-flash"
GEMINI_TTS_MODEL="gemini-3.1-flash-tts-preview"
GEMINI_TTS_VOICE="Laomedeia"
GEMINI_SUMMARY_MODEL="gemini-2.5-flash"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"
GEMINI_VIDEO_MODEL="veo-3.1-generate-preview"
HOST_IMAGE_STYLE="un animateur de podcast tech jeune et dynamique dans un studio de podcast moderne et lumineux avec microphone professionnel"
PROXY_ENDPOINT=""
PROXY_API_KEY=""

# Spotify (AWS Secrets Manager)
SPOTIFY_SECRET_NAME="${PROJECT_PREFIX}-SpotifyCredentials"
SPOTIFY_SHOW_ID=""
SPOTIFY_EPISODE_DESCRIPTION="Votre épisode dédié aux dernières innovations et technologies."

# Distribution (Optionnel)
CLOUDFRONT_DOMAIN=""
HEYGEN_API_KEY=""
HEYGEN_AVATAR_ID=""
BUFFER_ACCESS_TOKEN=""
BUFFER_PROFILE_ID=""
